{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "prisma/**",
      "public/**",
      "package.json",
      "next.config.ts",
      "tsconfig.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "volumes": [
      {
        "name": "maxmod-data",
        "mountPath": "/data",
        "size": "1GB"
      }
    ]
  }
}
