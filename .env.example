# ==========================================
# Maxmod Panel - Environment Variables
# ==========================================
# Copy this file to .env and customize values

# Database (SQLite file path)
# - Local dev: file:/home/z/my-project/db/custom.db
# - Railway:   file:/data/custom.db   (MUST point to the volume mount path)
DATABASE_URL="file:/data/custom.db"

# Port (Railway sets this automatically, defaults to 8080)
PORT=8080

# Node environment
NODE_ENV=production

# Hostname for the server (0.0.0.0 = all interfaces, required for Railway)
HOSTNAME=0.0.0.0

# ==========================================
# Railway Deployment — Volume Setup (CRITICAL)
# ==========================================
# Without a Volume, the SQLite database is wiped on every redeploy!
#
# Option A — Config-as-Code (automatic via railway.toml / railway.json):
#   The volume is already declared in railway.toml / railway.json:
#     name: maxmod-data
#     mountPath: /data
#     size: 1GB
#   Just push to GitHub and Railway will create it automatically.
#
# Option B — Manual (via Railway dashboard):
#   1. Open your project → click the service (maxmod-panel)
#   2. Go to Settings → Volumes → click "New Volume"
#   3. Mount path: /data
#   4. Size: 1 GB (or more if needed)
#   5. Click Add Volume
#   6. Railway will restart the service automatically
#
# Then set this env var in Railway (Variables tab):
#   DATABASE_URL = file:/data/custom.db
#
# Other notes:
#   - Railway auto-sets PORT=8080 in the container
#   - To generate a domain: Settings → Networking → Generate Domain
#   - SSL is auto-managed by Railway
